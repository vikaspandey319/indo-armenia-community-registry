# Server-only Netlify Function settings. Keep real values out of git.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project"}
MEMBER_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
FIRESTORE_DATABASE_ID=(default)

# Optional Gemini feature key, if AI features are enabled.
GEMINI_API_KEY=
